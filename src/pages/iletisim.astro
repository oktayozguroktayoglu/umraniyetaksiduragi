---
import Base from '../layouts/Base.astro';
import { BRAND, PHONE_DISPLAY, PHONE_TEL, ADDRESS, waLink } from '../data/site.js';
import { dataOf } from '../lib/mahalle.js';
import MapBox from '../components/MapBox.astro';
const c = dataOf('tepeustu').center;
const map = c ? `https://www.google.com/maps/search/?api=1&query=${c.lat},${c.lon}` : 'https://www.google.com/maps/search/?api=1&query=Tepe%C3%BCst%C3%BC+%C3%9Cmraniye';
---
<Base title={`İletişim | ${BRAND} ${PHONE_DISPLAY}`} description={`${BRAND} iletişim: ${PHONE_DISPLAY}, WhatsApp ve adres bilgisi. ${ADDRESS.street}, Ümraniye/İstanbul.`} crumbs={[['İletişim', '/iletisim/']]}>
  <section class="page-head"><div class="wrap"><h1>İletişim</h1><p>Taksi çağırmak için en hızlı yol telefon. WhatsApp’tan konum göndererek de araç isteyebilirsiniz.</p></div></section>
  <section class="sec"><div class="wrap grid g3">
    <div class="card"><h2 style="font-size:20px">Telefon</h2><p><a href={`tel:${PHONE_TEL}`} data-ev="call_contact">{PHONE_DISPLAY}</a></p></div>
    <div class="card"><h2 style="font-size:20px">WhatsApp</h2><p><a href={waLink()} rel="noopener" data-ev="wa_contact" data-wa-loc>Konum gönder</a></p></div>
    <div class="card"><h2 style="font-size:20px">Adres</h2><p>{ADDRESS.street}<br />{ADDRESS.district} / {ADDRESS.city}</p><a class="more" href={map} rel="noopener">Haritada aç →</a></div>
  </div></section>
  <section class="sec" style="padding-top:0"><div class="wrap"><MapBox /></div></section>
</Base>
