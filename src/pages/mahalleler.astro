---
import Base from '../layouts/Base.astro';
import { MAHALLELER, PHONE_DISPLAY, PHONE_TEL } from '../data/site.js';
import { dataOf } from '../lib/mahalle.js';
const rows = MAHALLELER.map((m) => ({ m, d: dataOf(m.slug) }));
---
<Base
  title="Ümraniye Mahalleleri Taksi | 37 Mahalleye Taksi Durağı"
  description={`Ümraniye’nin 37 mahallesinin tamamına taksi: Atakent’ten Yukarı Dudullu’ya mahallenizi seçin, ${PHONE_DISPLAY}’yi arayın.`}
  crumbs={[['Mahalleler', '/mahalleler/']]}
>
  <section class="page-head">
    <div class="wrap">
      <h1>Ümraniye mahallelerine taksi</h1>
      <p>Ümraniye’de 37 mahalle var ve hepsine taksi gönderiyoruz. Mahallenizin sayfasında öne çıkan noktaları, en yakın metro istasyonunu ve havalimanlarına mesafeyi bulabilirsiniz.</p>
      <a class="btn btn-call" href={`tel:${PHONE_TEL}`} data-ev="call_hub">Hemen Ara: {PHONE_DISPLAY}</a>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <ul class="mah-grid">
        {rows.map(({ m, d }) => (
          <li><a href={m.url}>{m.name} Taksi
            {d.stations?.[0] && <small>En yakın istasyon: {d.stations[0].name}</small>}
            {d.drive?.saw && <small>Sabiha Gökçen ~{d.drive.saw.min} dk</small>}
          </a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
