---
import { MAHALLELER } from '../data/site.js';
import { dataOf } from '../lib/mahalle.js';
const { id = 'mahlist', detail = 'durak' } = Astro.props;
---
<div class="mah-search">
  <label for={`${id}-q`}>Mahallenizi arayın</label>
  <input id={`${id}-q`} type="search" placeholder="Örn. Çakmak, Şerifali…" autocomplete="off" data-mah-filter={id} />
</div>
<ul class="mah-grid" id={id}>
  {MAHALLELER.map((m) => {
    const d = dataOf(m.slug);
    return (
      <li><a href={m.url}>{m.name} Taksi
        {detail === 'durak' && m.slug === 'tepeustu' && <small>Durağımız burada</small>}
        {detail === 'durak' && m.slug !== 'tepeustu' && d.drive?.durak && <small>Duraktan ~{d.drive.durak.min} dk</small>}
        {detail === 'full' && d.stations?.[0] && <small>En yakın istasyon: {d.stations[0].name}</small>}
        {detail === 'full' && d.drive?.saw && <small>Sabiha Gökçen ~{d.drive.saw.min} dk</small>}
      </a></li>
    );
  })}
</ul>
<p class="mah-empty" role="status">Bu adla bir mahalle bulunamadı. Bizi arayın, adresinizi birlikte bulalım.</p>
