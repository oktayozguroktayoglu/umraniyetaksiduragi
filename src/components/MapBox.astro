---
import { dataOf } from '../lib/mahalle.js';
const c = dataOf('tepeustu').center || { lat: 41.0255, lon: 29.1245 };
const d = 0.012;
const src = `https://www.openstreetmap.org/export/embed.html?bbox=${c.lon - d},${c.lat - d * 0.7},${c.lon + d},${c.lat + d * 0.7}&layer=mapnik&marker=${c.lat},${c.lon}`;
const gmaps = `https://www.google.com/maps/search/?api=1&query=${c.lat},${c.lon}`;
---
<div class="mapbox">
  <button class="btn btn-call" type="button" data-map-src={src}>Haritayı göster</button>
</div>
<p class="note"><a href={gmaps} rel="noopener">Google Haritalar’da aç →</a></p>
